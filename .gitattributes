# Governance checksums bind exact bytes, including line endings. Never let a
# platform checkout silently rewrite registered/generated evidence artifacts.
data/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
eval/abdm*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
